# Copie para .env e preencha com valores reais. Nunca commitar .env.

# App
APP_URL=http://localhost:5173
PORT=3000

# Banco de dados (Postgres)
DB_HOST=db
DB_PORT=5432
DB_NAME=quickodonto
DB_USER=quickodonto
DB_PASSWORD=troque-esta-senha

# Autenticação
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-longo
JWT_EXPIRES=15m

# E-mail transacional (convite, redefinição de senha, recibo)
# Em dev: SMTP_HOST=mailpit e SMTP_PORT=1025 (caixa de entrada em http://localhost:8025)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="QuickOdonto <nao-responda@quickodonto.com.br>"

# Criptografia de campo (seção 3.1). Gerar cada uma com: openssl rand -base64 32
# Perder a ENC_KEY = perder os dados cifrados. Guardar cópia em cofre + cópia offline.
ENC_KEY=
HMAC_KEY=

# Anexos clínicos (gravados cifrados, fora de qualquer diretório público)
STORAGE_DIR=/data/anexos
